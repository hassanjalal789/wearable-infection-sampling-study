# Era-matched environment for WearableDetection / Alarm (RHR-Diff, CuSum).
# Needs R packages xts and zoo.  CRAN was unreachable from the Phase-1 container
# (available.packages() returned 0 rows), which is why Gate A1 -- the only
# byte-diffable gate in the whole set -- is still BLOCKED.
FROM rocker/r-ver:4.3.3
RUN R -e "install.packages(c('zoo','xts'), repos='https://cloud.r-project.org')"
WORKDIR /work
